## Environment / secrets — copy this file to .env and fill in values.
## .env is gitignored and never committed.
## The app reads API keys from config/config.py (managed via the Settings UI).
## Use this file only as a reference for what keys are supported.

# ── AI Mode ───────────────────────────────────────────────────────────────────
# 'privacy'  = fully offline, uses local Ollama
# 'cloud'    = uses one or more cloud AI providers below
APP_MODE=cloud

# ── Cloud AI Providers (enable at most one or several for load balancing) ─────
ANTHROPIC_KEY=sk-ant-...
GEMINI_KEY=AIza...
GROQ_KEY=gsk_...
OPENAI_KEY=sk-...
NVIDIA_KEY=nvapi-...
OPENROUTER_KEY=sk-or-...
GITHUB_KEY=ghp_...

# ── Models (leave blank to use defaults) ──────────────────────────────────────
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama3-8b-8192
OPENAI_MODEL=gpt-4o-mini
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ── Ollama (local / offline) ──────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Security ──────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change-this-to-a-long-random-string
LOGIN_ENABLED=false
HR_USERNAME=admin
HR_PASSWORD=admin
