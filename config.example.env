# ---------------------------------------------------------
# AI Recruitment System - Example Environment Configuration
# ---------------------------------------------------------
# Copy this file to .env and configure the variables below.
# Do NOT commit your actual .env file to version control.

# -- FLASK SECURITY --
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# -- LOCAL AI PROVIDER (OLLAMA) --
# Custom storage path for large local AI models
# OLLAMA_MODELS=D:\Ollama\Models
# OLLAMA_HOST=127.0.0.1:11434

# -- EXTERNAL AI PROVIDER KEYS --
# Provide keys for the services you wish to use.
# Leave blank if using local Privacy Mode.
OPENAI_KEY=
ANTHROPIC_KEY=
GEMINI_KEY=
GROQ_KEY=
NVIDIA_KEY=
OPENROUTER_KEY=
GITHUB_KEY=
OLLAMA_CLOUD_KEY=

# -- SMTP EMAIL SETTINGS --
SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# -- PORT CONFIGURATION --
# ARS_CANDIDATE_PORT=5000
# ARS_DESKTOP_PORT=5001
